    {
      "id": "FBEWgxWA2EKblKnA-umU1",
      "type": "text",
      "x": -14620,
      "y": -6475,
      "width": 592,
      "height": 120,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
