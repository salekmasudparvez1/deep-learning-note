    {
      "id": "63erKKqi64s2huSuDRiy2",
      "type": "text",
      "x": -14530,
      "y": -10700,
      "width": 1040,
      "height": 30,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
