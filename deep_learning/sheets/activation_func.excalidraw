    },
    {
      "id": "6gIhLc1ui-6HjzGLvSAaw",
      "type": "text",
      "x": -14939.272727272728,
      "y": -13588.909090909092,
      "width": 592,
      "height": 161.45454545454547,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
