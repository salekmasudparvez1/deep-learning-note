      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "Outputs zero for all negative inputs.\nIntroduces network sparsity so only a fraction\nof neurons fire, speeding up computation.",
      "fontSize": 21.527272727272727,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Outputs zero for all negative inputs.\nIntroduces network sparsity so only a fraction\nof neurons fire, speeding up computation.",
