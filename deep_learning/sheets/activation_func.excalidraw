    {
      "id": "Gjqh_Kz5dDWfZaNF4RM0C",
      "type": "text",
      "x": -17660,
      "y": -18225,
      "width": 300,
      "height": 180,
      "angle": 0,
      "strokeColor": "#4a148c",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 644711343,
      "version": 6,
      "versionNonce": 1887016847,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "Key Properties:\n• Small constant slope α (e.g. 0.01) for x < 0\n• Ensures non-zero gradient across all inputs\n• Completely resolves the \"Dying ReLU\" issue\n• Fast to compute like ReLU",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFq",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "Key Properties:\n• Small constant slope α (e.g. 0.01) for x < 0\n• Ensures non-zero gradient across all inputs\n• Completely resolves the \"Dying ReLU\" issue\n• Fast to compute like ReLU",
      "autoResize": true,
      "lineHeight": 2.25
    },
