      "text": "Leaky ReLU Activation Function",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leaky ReLU Activation Function",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "93x7MUQM6of2zqJ4M_Zoe",
      "type": "text",
      "x": -14647,
      "y": -7170,
      "width": 1200,
      "height": 75,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "fkthoG5kPr56nnENVnIpU"
      ],
      "frameId": "H-AJiuUx2NOtWlgfNbbvQ",
      "index": "bA9",
      "roundness": null,
      "seed": 1232006305,
      "version": 540,
      "versionNonce": 1446520385,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "Leaky ReLU is a variant of ReLU that solves the 'Dying ReLU' problem\nby allowing a small negative slope (α ≈ 0.01) when x < 0. This prevents\nneurons from dying and ensures gradients flow during backpropagation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leaky ReLU is a variant of ReLU that solves the 'Dying ReLU' problem\nby allowing a small negative slope (α ≈ 0.01) when x < 0. This prevents\nneurons from dying and ensures gradients flow during backpropagation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Atc-prOsLDarQUCarek0U",
      "type": "text",
      "x": -14647,
      "y": -7070,
      "width": 500,
      "height": 40,
      "angle": 0,
      "strokeColor": "#4338ca",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "fkthoG5kPr56nnENVnIpU"
      ],
      "frameId": "H-AJiuUx2NOtWlgfNbbvQ",
      "index": "bAA",
      "roundness": null,
      "seed": 1829417089,
      "version": 797,
      "versionNonce": 1702173263,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "f(x) = max(αx, x)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(x) = max(αx, x)",
      "autoResize": true,
      "lineHeight": 1.25
    },
