      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDg",
      "roundness": null,
      "seed": 557725199,
      "version": 737,
      "versionNonce": 956674081,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "• Output: probability distribution over classes",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
