      "text": "Softmax Activation Function",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Softmax Activation Function",
      "autoResize": true,
