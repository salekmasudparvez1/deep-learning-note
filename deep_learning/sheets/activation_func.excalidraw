      "isDeleted": false,
      "boundElements": [],
      "updated": 1785863014227,
      "link": null,
      "locked": false,
      "text": "📌 Note: Parametric ReLU (PReLU)\nIn PReLU, the parameter α is not fixed (e.g. 0.01) but \nbecomes a trainable parameter learned automatically \nduring neural network backpropagation.",
      "fontSize": 15,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "📌 Note: Parametric ReLU (PReLU)\nIn PReLU, the parameter α is not fixed (e.g. 0.01) but \nbecomes a trainable parameter learned automatically \nduring neural network backpropagation.",
      "index": "bJ0",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
