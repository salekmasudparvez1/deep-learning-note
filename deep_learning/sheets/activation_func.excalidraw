      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Requires basic thresholding operation only.\nEasy to compute and scales well when training\ndeep networks with millions of parameters.",
      "fontSize": 21.527272727272727,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Requires basic thresholding operation only.\nEasy to compute and scales well when training\ndeep networks with millions of parameters.",
