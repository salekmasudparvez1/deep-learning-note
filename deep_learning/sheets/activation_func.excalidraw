      "link": null,
      "locked": false,
      "text": "⚠ Warning: Dying ReLU Problem\nNeurons can sometimes get stuck in an inactive state where \nthey output 0 for all inputs, preventing gradients from \nupdating their weights forever.",
      "fontSize": 15,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "⚠ Warning: Dying ReLU Problem\nNeurons can sometimes get stuck in an inactive state where \nthey output 0 for all inputs, preventing gradients from \nupdating their weights forever.",
      "index": "bIl",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25
