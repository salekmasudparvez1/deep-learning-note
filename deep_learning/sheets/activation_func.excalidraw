      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "• if x > 0 -> output = x",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• if x > 0 -> output = x",
