      "link": null,
      "locked": false,
      "text": "📈 Efficient Backpropagation",
      "fontSize": 26.90909090909091,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "📈 Efficient Backpropagation",
      "autoResize": true,
      "lineHeight": 1.5
    },
    {
      "id": "8MZrhAlHZ7mYqJEc-LOEY",
      "type": "text",
      "x": -14239.636363636364,
      "y": -13588.909090909092,
      "width": 592,
      "height": 161.45454545454547,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bD9",
      "roundness": null,
      "seed": 115738607,
      "version": 163,
      "versionNonce": 799702607,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Derivative is simple: 0 for x <= 0 and 1 for x > 0.\nPrevents the vanishing gradient problem common\nwith sigmoid or tanh functions.",
      "fontSize": 21.527272727272727,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Derivative is simple: 0 for x <= 0 and 1 for x > 0.\nPrevents the vanishing gradient problem common\nwith sigmoid or tanh functions.",
      "autoResize": true,
      "lineHeight": 2.5
    },
