      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "Properties & Advantages:\n• Piecewise linear function\n• Derivative: f'(x) = 1 for x>0, 0 for x<0\n• Computationally extremely fast\n• Promotes sparse activation\n• Avoids vanishing gradient for x > 0",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFf",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "Properties & Advantages:\n• Piecewise linear function\n• Derivative: f'(x) = 1 for x>0, 0 for x<0\n• Computationally extremely fast\n• Promotes sparse activation\n• Avoids vanishing gradient for x > 0",
      "autoResize": true,
      "lineHeight": 1.875
    },
