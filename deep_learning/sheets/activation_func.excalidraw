      "text": "🔄 Non-Linearity",
      "fontSize": 26.90909090909091,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "🔄 Non-Linearity",
      "autoResize": true,
      "lineHeight": 1.5
    },
    {
      "id": "rl-c3yph4dz556tHAlKFL",
      "type": "text",
      "x": -14239.636363636364,
      "y": -13871.454545454546,
      "width": 592,
      "height": 161.45454545454547,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
