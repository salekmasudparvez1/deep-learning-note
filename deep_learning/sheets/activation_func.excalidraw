      "text": "🎯 Sparse Activation",
      "fontSize": 26.90909090909091,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "🎯 Sparse Activation",
