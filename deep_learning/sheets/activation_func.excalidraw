      "link": null,
      "locked": false,
      "text": "🌀 Leaky ReLU",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "🌀 Leaky ReLU",
