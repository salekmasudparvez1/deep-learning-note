      "seed": 1440064495,
      "version": 6,
      "versionNonce": 262000047,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "💡 Variant: Parametric ReLU (PReLU)\nInstead of fixing α to a static value (0.01), α is treated as a learnable parameter during backpropagation.\nAllows the model to learn the optimal leakiness adaptively for each channel.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFs",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "💡 Variant: Parametric ReLU (PReLU)\nInstead of fixing α to a static value (0.01), α is treated as a learnable parameter during backpropagation.\nAllows the model to learn the optimal leakiness adaptively for each channel.",
      "autoResize": true,
      "lineHeight": 3.75
    },
