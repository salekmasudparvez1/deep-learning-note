      "id": "UB00mjMxeNkawDb2tw1rF",
      "type": "text",
      "x": -14967,
      "y": -11525,
      "width": 600,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
