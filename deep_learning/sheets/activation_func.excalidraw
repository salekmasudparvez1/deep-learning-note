    {
      "id": "PUJL2ChLc39IGiDB1K12Q",
      "type": "text",
      "x": -17300,
      "y": -19325,
      "width": 300,
      "height": 180,
      "angle": 0,
      "strokeColor": "#b71c1c",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 1272697135,
      "version": 6,
      "versionNonce": 1785355855,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "⚠️ Warning: Vanishing Gradient\nWhen x is large positive/negative, σ'(x) ≈ 0.\nGradients shrink exponentially during backpropagation, halting learning in deep layers.\nMax derivative at x=0 is only 0.25.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFW",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "⚠️ Warning: Vanishing Gradient\nWhen x is large positive/negative, σ'(x) ≈ 0.\nGradients shrink exponentially during backpropagation, halting learning in deep layers.\nMax derivative at x=0 is only 0.25.",
      "autoResize": true,
      "lineHeight": 2.8125
    },
