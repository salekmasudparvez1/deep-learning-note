      "isDeleted": false,
      "boundElements": [],
      "updated": 1785863014227,
      "link": null,
      "locked": false,
      "text": "Improves ReLU by allowing a small negative slope for x < 0.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Improves ReLU by allowing a small negative slope for x < 0.",
      "index": "bIv",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.375
    },
