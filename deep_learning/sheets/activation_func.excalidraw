      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862373524,
      "link": null,
      "locked": false,
      "text": "Properties & Derivative:\n• Domain: (-∞, +∞)\n• Range: (0, 1)\n• Monotonic increasing & Differentiable\n• Derivative: σ'(x) = σ(x)(1 − σ(x))\n• Applications: Binary Classification, Output Layer",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Properties & Derivative:\n• Domain: (-∞, +∞)\n• Range: (0, 1)\n• Monotonic increasing & Differentiable\n• Derivative: σ'(x) = σ(x)(1 − σ(x))\n• Applications: Binary Classification, Output Layer",
      "index": "bHK",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.6666666666666667
    },
