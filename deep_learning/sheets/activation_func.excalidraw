      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "Derivative is simple: 0 for x <= 0 and 1 for x > 0.\nPrevents the vanishing gradient problem common\nwith sigmoid or tanh functions.",
      "fontSize": 21.527272727272727,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Derivative is simple: 0 for x <= 0 and 1 for x > 0.\nPrevents the vanishing gradient problem common\nwith sigmoid or tanh functions.",
      "autoResize": true,
      "lineHeight": 2.5
    },
