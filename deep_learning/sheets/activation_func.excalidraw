      "index": "bD3",
      "roundness": null,
      "seed": 1961326383,
      "version": 162,
      "versionNonce": 1670695919,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Despite piecewise structure, it is non-linear.\nEnables models to capture intricate patterns\nand learn complex relationships between features.",
      "fontSize": 21.527272727272727,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Despite piecewise structure, it is non-linear.\nEnables models to capture intricate patterns\nand learn complex relationships between features.",
