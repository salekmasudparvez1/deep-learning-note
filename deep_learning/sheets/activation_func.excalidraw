    },
    {
      "id": "I1zt6ESkWUWjonxorptiT",
      "type": "text",
      "x": -14800,
      "y": -17330,
      "width": 400,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bEh",
      "roundness": null,
      "seed": 1212847087,
      "version": 236,
