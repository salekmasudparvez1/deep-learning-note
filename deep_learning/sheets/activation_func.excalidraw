      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "📌 Note: Softmax vs Sigmoid\n• Sigmoid is a special case of Softmax for binary classification (K=2).\n• Sigmoid treats classes independently (multi-label), while Softmax outputs are mutually exclusive.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bG1",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "📌 Note: Softmax vs Sigmoid\n• Sigmoid is a special case of Softmax for binary classification (K=2).\n• Sigmoid treats classes independently (multi-label), while Softmax outputs are mutually exclusive.",
      "autoResize": true,
      "lineHeight": 6.25
    },
