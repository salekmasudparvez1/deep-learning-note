      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "Properties:\n• Normalizes K real numbers to probabilities\n• Output values range strictly between (0, 1)\n• Sum of all output probabilities = 1.0\n• Highlights the largest element (acts soft max)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFx",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "Properties:\n• Normalizes K real numbers to probabilities\n• Output values range strictly between (0, 1)\n• Sum of all output probabilities = 1.0\n• Highlights the largest element (acts soft max)",
      "autoResize": true,
      "lineHeight": 3.75
    },
