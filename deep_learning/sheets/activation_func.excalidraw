    {
      "id": "gl1TPrT20lMNDPv8LUCrY",
      "type": "text",
      "x": -14620,
      "y": -9180,
      "width": 1180.3587646484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "#fff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "H-AJiuUx2NOtWlgfNbbvQ",
      "index": "b9f",
      "roundness": null,
      "seed": 631880801,
      "version": 124,
      "versionNonce": 260085793,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "ReLU is a widely used activation function in deep learning that outputs the input directly if it is positive and returns \nzero otherwise. Its simplicity and efficiency make it a default choice in many neural network architectures, helping models\nlearn complex patterns while reducing issues like the vanishing gradient problem.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReLU is a widely used activation function in deep learning that outputs the input directly if it is positive and returns \nzero otherwise. Its simplicity and efficiency make it a default choice in many neural network architectures, helping models\nlearn complex patterns while reducing issues like the vanishing gradient problem.",
      "autoResize": true,
      "lineHeight": 1.25
    },
