    {
      "id": "M1ENs6ebWNEOAatb2VitH",
      "type": "text",
      "x": -17660,
      "y": -19325,
      "width": 300,
      "height": 180,
      "angle": 0,
      "strokeColor": "#0d47a1",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 134349039,
      "version": 6,
      "versionNonce": 1085520943,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "Properties:\n• Domain: (-∞, +∞)\n• Range: (0, 1)\n• Monotonic: Monotonically increasing\n• Differentiable: Smooth everywhere\n• Derivative: σ'(x) = σ(x)(1 - σ(x))",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFU",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "Properties:\n• Domain: (-∞, +∞)\n• Range: (0, 1)\n• Monotonic: Monotonically increasing\n• Differentiable: Smooth everywhere\n• Derivative: σ'(x) = σ(x)(1 - σ(x))",
      "autoResize": true,
      "lineHeight": 1.875
    },
    {
