    {
      "id": "h5dDmqz78ncvx6yFeqV_A",
      "type": "text",
      "x": -14193,
      "y": -12245,
      "width": 592,
      "height": 120,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "l8OTgn92GkJvW3j7JG2w9"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDW",
      "roundness": null,
      "seed": 1016376047,
      "version": 371,
      "versionNonce": 254173135,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Non-zero gradient for x < 0 ensures continued learning.\nEspecially useful in deep networks where standard ReLU\nmay cause many neurons to die during training.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-zero gradient for x < 0 ensures continued learning.\nEspecially useful in deep networks where standard ReLU\nmay cause many neurons to die during training.",
      "autoResize": true,
      "lineHeight": 1.25
    },
