      "seed": 320583937,
      "version": 116,
      "versionNonce": 580194831,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122381,
      "link": null,
      "locked": false,
      "text": "Q: Why did the ReLU activation function break up with its partner?\nAnswer: Because it just couldn't handle the negative energy!",
      "fontSize": 24.21818181818182,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Q: Why did the ReLU activation function break up with its partner?\nAnswer: Because it just couldn't handle the negative energy!",
      "autoResize": true,
      "lineHeight": 2.638888888888889
    },
