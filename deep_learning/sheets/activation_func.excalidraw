      "isDeleted": false,
      "boundElements": [],
      "updated": 1785863014227,
      "link": null,
      "locked": false,
      "text": "Properties & Advantages:\n• Negative values survive with small slope α\n• Prevents 'Dying ReLU' problem entirely\n• Stable gradient flow during backprop\n• Computationally efficient\n• Better overall gradient distribution",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Properties & Advantages:\n• Negative values survive with small slope α\n• Prevents 'Dying ReLU' problem entirely\n• Stable gradient flow during backprop\n• Computationally efficient\n• Better overall gradient distribution",
      "index": "bIz",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.6666666666666667
    },
