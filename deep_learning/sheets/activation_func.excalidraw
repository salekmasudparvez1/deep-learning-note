      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862373524,
      "link": null,
      "locked": false,
      "text": "⚠ Warning: Vanishing Gradient\nWhen x becomes very positive or negative, gradients approach zero, severely slowing down learning during backpropagation.\n\nPros: Clear probabilistic interpretation.\nCons: Vanishing gradient, non-zero centered output.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "⚠ Warning: Vanishing Gradient\nWhen x becomes very positive or negative, gradients approach zero, severely slowing down learning during backpropagation.\n\nPros: Clear probabilistic interpretation.\nCons: Vanishing gradient, non-zero centered output.",
      "index": "bHM",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 2
