    {
      "id": "9s0Kd01CeXcqqcJnlaeW2",
      "type": "text",
      "x": -18120,
      "y": -17670,
      "width": 320,
      "height": 300,
      "angle": 0,
      "strokeColor": "#b71c1c",
      "backgroundColor": "transparent",
