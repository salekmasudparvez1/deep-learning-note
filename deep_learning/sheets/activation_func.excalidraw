    },
    {
      "id": "WXAd7ywNsT7f85w18t-DA",
      "type": "text",
      "x": 644,
      "y": -618,
      "width": 500,
      "height": 22,
      "angle": 0,
      "strokeColor": "#4B5563",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "wVPvzSRgK0qK2PaLYprZT",
        "vkXz-ODIcT6bcmlu9y504"
      ],
      "roundness": null,
      "seed": 843961217,
