    {
      "id": "yc7iV93rRcBKtDcXlVCZi",
      "type": "text",
      "x": -17300,
      "y": -18225,
      "width": 300,
      "height": 180,
      "angle": 0,
      "strokeColor": "#4a148c",
      "backgroundColor": "transparent",
