    {
      "id": "2s4eDc2NNu23ADjbGVAO3",
      "type": "text",
      "x": -14967,
      "y": -12950,
      "width": 1200,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDF",
      "roundness": null,
      "seed": 208734383,
      "version": 587,
      "versionNonce": 1883032751,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Leaky ReLU is a variant of ReLU that solves the 'Dying ReLU' problem\nby allowing a small negative slope (α ≈ 0.01) when x < 0. This prevents\nneurons from dying and ensures gradients flow during backpropagation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leaky ReLU is a variant of ReLU that solves the 'Dying ReLU' problem\nby allowing a small negative slope (α ≈ 0.01) when x < 0. This prevents\nneurons from dying and ensures gradients flow during backpropagation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m55nf_sJYFT2KE5eGGFEo",
      "type": "text",
      "x": -14967,
      "y": -12850,
      "width": 500,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDG",
      "roundness": null,
      "seed": 1506417359,
      "version": 844,
      "versionNonce": 1481038273,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "f(x) = max(αx, x)",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(x) = max(αx, x)",
      "autoResize": true,
      "lineHeight": 1.25
    },
