      "text": "🔄 Non-Linearity",
      "fontSize": 26.90909090909091,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "🔄 Non-Linearity",
