      "index": "bAE",
      "roundness": null,
      "seed": 838985729,
      "version": 328,
      "versionNonce": 1101009551,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122382,
      "link": null,
      "locked": false,
      "text": "• if x > 0 -> output = x",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• if x > 0 -> output = x",
      "autoResize": true,
      "lineHeight": 1.25
    },
