      "isDeleted": false,
      "boundElements": [],
      "updated": 1785863014227,
      "link": null,
      "locked": false,
      "text": "Properties & Advantages:\n• Piecewise linear function\n• Derivative: 0 for x<0, 1 for x>0\n• Highly efficient computation & sparse \nactivation\n• Fast convergence in SGD\n• Applications: CNNs, MLPs, Transformers",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Properties & Advantages:\n• Piecewise linear function\n• Derivative: 0 for x<0, 1 for x>0\n• Highly efficient computation & sparse \nactivation\n• Fast convergence in SGD\n• Applications: CNNs, MLPs, Transformers",
      "index": "bIk",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
