      "link": null,
      "locked": false,
      "text": "Formula:  f(x) = max(αx, x),  where α ≈ 0.01",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Formula:  f(x) = max(αx, x),  where α ≈ 0.01",
      "index": "bIx",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.5
    },
