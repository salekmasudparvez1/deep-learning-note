      "link": null,
      "locked": false,
      "text": "⚡ Fixes Dying ReLU Problem",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚡ Fixes Dying ReLU Problem",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AvQXmvVT3VCIhhoxXWm1_",
      "type": "text",
      "x": -14940,
      "y": -12255,
      "width": 491.4867858886719,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDU",
      "roundness": null,
      "seed": 156873871,
      "version": 526,
      "versionNonce": 1118997729,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Allows small negative values instead of zeroing out.\nGradients can flow even for negative inputs, preventing\nneurons from becoming permanently inactive.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Allows small negative values instead of zeroing out.\nGradients can flow even for negative inputs, preventing\nneurons from becoming permanently inactive.",
      "autoResize": true,
      "lineHeight": 1.25
    },
