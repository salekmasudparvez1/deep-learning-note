    },
    {
      "id": "Xf4YZGEu9r_N8mjjMAWlz",
      "type": "text",
      "x": -14967,
      "y": -11850,
      "width": 1200,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDa",
      "roundness": null,
      "seed": 1369619791,
      "version": 926,
      "versionNonce": 1785973889,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Softmax is an activation function used primarily in the output layer of\nmulti-class classification neural networks. It converts raw logits into\nprobabilities by exponentiating and normalizing, ensuring outputs sum to 1.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Softmax is an activation function used primarily in the output layer of\nmulti-class classification neural networks. It converts raw logits into\nprobabilities by exponentiating and normalizing, ensuring outputs sum to 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HgxdtRU1MGeJ_SL4tiyvM",
      "type": "text",
      "x": -14967,
      "y": -11745,
      "width": 500,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDb",
      "roundness": null,
      "seed": 1142700911,
      "version": 410,
      "versionNonce": 14546959,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "σ(z_i) = e^{z_i} / Σ_j e^{z_j}",
      "fontSize": 26,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "σ(z_i) = e^{z_i} / Σ_j e^{z_j}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lQJ4LgrnGJKVjz396A-FN",
      "type": "text",
      "x": -14967,
      "y": -11685,
      "width": 200,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDc",
      "roundness": null,
      "seed": 1124136335,
      "version": 217,
      "versionNonce": 2116588641,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Where:",
      "fontSize": 24,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Where:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oSfoH22snZe9H7m-eImur",
      "type": "text",
      "x": -14967,
      "y": -11645,
      "width": 600,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDd",
      "roundness": null,
      "seed": 361327535,
      "version": 711,
      "versionNonce": 1168252463,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "• z_i = raw output (logit) for class i",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• z_i = raw output (logit) for class i",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JCM-UaklG43hhc8QAGsik",
      "type": "text",
      "x": -14967,
      "y": -11605,
      "width": 600,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDe",
      "roundness": null,
      "seed": 131997135,
      "version": 921,
      "versionNonce": 1941528641,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "• e^{z_i} = exponential of the logit",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• e^{z_i} = exponential of the logit",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6l6EAUiO8MXe19Hx-MQp3",
      "type": "text",
      "x": -14967,
      "y": -11565,
      "width": 600,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDf",
      "roundness": null,
      "seed": 1293388783,
      "version": 331,
      "versionNonce": 1195147343,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "• Σ_j e^{z_j} = sum of all exponentials",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Σ_j e^{z_j} = sum of all exponentials",
      "autoResize": true,
      "lineHeight": 1.25
    },
