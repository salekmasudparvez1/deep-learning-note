    {
      "id": "nR8yxlPbevbuP0aV78dFq",
      "type": "text",
      "x": -14647,
      "y": -6070,
      "width": 1200,
      "height": 75,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "fkthoG5kPr56nnENVnIpU"
      ],
      "frameId": "H-AJiuUx2NOtWlgfNbbvQ",
      "index": "bAU",
      "roundness": null,
      "seed": 1773225473,
      "version": 879,
      "versionNonce": 680088463,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122382,
      "link": null,
      "locked": false,
      "text": "Softmax is an activation function used primarily in the output layer of\nmulti-class classification neural networks. It converts raw logits into\nprobabilities by exponentiating and normalizing, ensuring outputs sum to 1.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Softmax is an activation function used primarily in the output layer of\nmulti-class classification neural networks. It converts raw logits into\nprobabilities by exponentiating and normalizing, ensuring outputs sum to 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BbOURc27o12u8b2a3Tn7z",
      "type": "text",
      "x": -14647,
      "y": -5965,
      "width": 500,
      "height": 40,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "fkthoG5kPr56nnENVnIpU"
      ],
      "frameId": "H-AJiuUx2NOtWlgfNbbvQ",
      "index": "bAV",
      "roundness": null,
      "seed": 2054872545,
      "version": 363,
      "versionNonce": 2115154145,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785861122382,
      "link": null,
      "locked": false,
      "text": "σ(z_i) = e^{z_i} / Σ_j e^{z_j}",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "σ(z_i) = e^{z_i} / Σ_j e^{z_j}",
