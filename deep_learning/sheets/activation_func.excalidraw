    {
      "id": "0cqy6mEbWV129FDaiASBo",
      "type": "text",
      "x": -14939.272727272728,
      "y": -13313.090909090908,
      "width": 1291.6363636363637,
      "height": 127.81818181818181,
      "angle": 0,
      "strokeColor": "#2d3436",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FX3et4eLxWPhAJi3BgLnL"
      ],
      "frameId": "vFDglZB8iOW2_peXRgBCX",
      "index": "bDC",
      "roundness": null,
      "seed": 2067085903,
      "version": 163,
      "versionNonce": 42575361,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785862359021,
      "link": null,
      "locked": false,
      "text": "Q: Why did the ReLU activation function break up with its partner?\nAnswer: Because it just couldn't handle the negative energy!",
      "fontSize": 24.21818181818182,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Q: Why did the ReLU activation function break up with its partner?\nAnswer: Because it just couldn't handle the negative energy!",
      "autoResize": true,
      "lineHeight": 2.638888888888889
    },
