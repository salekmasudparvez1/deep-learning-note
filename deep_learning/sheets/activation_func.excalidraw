      "boundElements": [],
      "updated": 1785861969154,
      "link": null,
      "locked": false,
      "text": "⚠️ Warning: Dying ReLU Problem\nIf inputs consistently fall below 0, gradients become 0.\nNeurons can become permanently inactive (\"dead\") and stop updating weights completely during training.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "index": "bFh",
      "frameId": null,
      "roundness": null,
      "containerId": null,
      "originalText": "⚠️ Warning: Dying ReLU Problem\nIf inputs consistently fall below 0, gradients become 0.\nNeurons can become permanently inactive (\"dead\") and stop updating weights completely during training.",
      "autoResize": true,
      "lineHeight": 3.75
    },
