{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "api/data.json"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/routine",
      "destination": "/web_view_routine.html"
    },
    {
      "source": "/(.*)",
      "destination": "/web_view_routine.html"
    }
  ]
}